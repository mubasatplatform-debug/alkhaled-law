# Neon Postgres (required in production — without it the app falls back to ephemeral PGLite)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=https://YOUR-DOMAIN

# OAuth (optional — email/password works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# AI concierge — voice STT/TTS + consultation (server-only)
XAI_API_KEY=
# Alternative assistant backend (chat + voice). Use a key from a BILLED Google
# project only: the free tier may use prompts for training and human review.
GEMINI_API_KEY=
# Optional: CONCIERGE_PROVIDER=xai|gemini (default: xAI if both keys exist),
# GEMINI_CHAT_MODEL, GEMINI_STT_MODEL, GEMINI_TTS_MODEL, GEMINI_TTS_VOICE

# Public flag (set by the host; defaults to auth on)
VITE_AUTH_ENABLED=true
